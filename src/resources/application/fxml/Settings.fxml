<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
	prefWidth="800.0"
	prefHeight="700.0"
	maxWidth="800.0"
	maxHeight="700.0"
	style="-fx-background-color: #0b1e49; -fx-background-radius: 22; -fx-border-color: #9aaeff; -fx-border-width: 2; -fx-border-radius: 22;"
	xmlns="http://javafx.com/javafx/26"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.controller.SettingsController">

	<children>
		<VBox alignment="TOP_CENTER" spacing="25.0">

			<padding>
				<Insets top="40.0" right="60.0" bottom="40.0" left="60.0"/>
			</padding>

			<children>

				<Label
					text="Settings"
					textFill="WHITE"
					style="-fx-font-family: 'Public Sans'; -fx-font-size: 42px; -fx-font-weight: bold;"/>

				<Label
					text="Manage your MediaVault account"
					textFill="#b9c6ef"
					style="-fx-font-family: 'Public Sans'; -fx-font-size: 18px;"/>

				<ImageView
					fx:id="profilePicture"
					fitHeight="140.0"
					fitWidth="140.0"
					pickOnBounds="true"
					preserveRatio="true"/>

				<Button
					text="Set Profile Picture"
					onAction="#handleProfilePicture"
					prefWidth="260.0"
					prefHeight="45.0"
					style="-fx-background-color: #7186d8; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 16px; -fx-font-weight: bold;"/>

				<TextField
					fx:id="usernameField"
					promptText="New Username"
					prefHeight="55.0"
					style="-fx-background-color: #f4f6ff; -fx-background-radius: 10; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-padding: 0 16 0 16;"/>

				<PasswordField
					fx:id="currentPasswordField"
					promptText="Current Password"
					prefHeight="55.0"
					style="-fx-background-color: #f4f6ff; -fx-background-radius: 10; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-padding: 0 16 0 16;"/>

				<PasswordField
					fx:id="newPasswordField"
					promptText="New Password"
					prefHeight="55.0"
					style="-fx-background-color: #f4f6ff; -fx-background-radius: 10; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-padding: 0 16 0 16;"/>

				<Label
					fx:id="statusLabel"
					textFill="#ff8f9b"
					visible="false"
					managed="false"
					style="-fx-font-family: 'Public Sans'; -fx-font-size: 15px;"/>

				<HBox alignment="CENTER" spacing="18.0">

					<children>

						<Button
							text="Save Changes"
							onAction="#handleSaveChanges"
							prefWidth="220.0"
							prefHeight="52.0"
							style="-fx-background-color: #7186d8; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-font-weight: bold;"/>

						<Button
							text="Delete Account"
							onAction="#handleDeleteAccount"
							prefWidth="220.0"
							prefHeight="52.0"
							style="-fx-background-color: #c63d50; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-font-weight: bold;"/>

					</children>

				</HBox>

				<Button
					text="Close"
					onAction="#handleClose"
					prefWidth="180.0"
					prefHeight="48.0"
					style="-fx-background-color: transparent; -fx-border-color: #9aaeff; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-font-weight: bold;"/>

			</children>

		</VBox>
	</children>

</StackPane>