<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="630.0" maxWidth="800.0" prefHeight="630.0" prefWidth="800.0" style="-fx-background-color: #0b1e49; -fx-background-radius: 22; -fx-border-color: #9aaeff; -fx-border-width: 2; -fx-border-radius: 22;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.SettingsController">
	<children>
		<VBox alignment="TOP_CENTER" spacing="25.0">
			<padding>
				<Insets bottom="30.0" left="60.0" right="60.0" top="30.0" />
			</padding>
			<children>
				<Label style="-fx-font-family: 'Public Sans'; -fx-font-size: 42px; -fx-font-weight: bold;" text="Create New Playlist" textFill="WHITE" />
				<ImageView fx:id="profilePicture" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />
				<Button onAction="#handleProfilePicture" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color: #7186d8; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 16px; -fx-font-weight: bold;" text="Set Playlist Picture" />
				<TextField fx:id="usernameField" prefHeight="55.0" promptText="New Username" style="-fx-background-color: #f4f6ff; -fx-background-radius: 10; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-padding: 0 16 0 16;" text="Enter Playlist Name" />
				<Label fx:id="statusLabel" managed="false" style="-fx-font-family: 'Public Sans'; -fx-font-size: 15px;" textFill="#ff8f9b" visible="false" />
				<HBox alignment="CENTER" spacing="18.0">
					<children>
      					<Button onAction="#handleSaveChanges" prefHeight="52.0" prefWidth="220.0" style="-fx-background-color: #7186d8; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-font-weight: bold;" text="Create" />
						<Button onAction="#handleDeleteAccount" prefHeight="52.0" prefWidth="220.0" style="-fx-background-color: #c63d50; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Public Sans'; -fx-font-size: 18px; -fx-font-weight: bold;" text="Cancel" />
					</children>
				</HBox>
			</children>
		</VBox>
	</children>
</StackPane>
