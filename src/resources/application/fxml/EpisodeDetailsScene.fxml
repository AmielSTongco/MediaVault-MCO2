<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" styleClass="media-details-root, episodes-details-theme" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.EpisodeDetailsController">
	<children>
		<Canvas fx:id="backgroundCanvas" mouseTransparent="true" />

		<BorderPane fx:id="rootPane">
			<top>
				<HBox maxHeight="105.0" minHeight="105.0" prefHeight="105.0" styleClass="nav-bar">
					<children>
						<HBox alignment="CENTER_LEFT" spacing="10.0">
							<children>
								<ImageView fx:id="mediaVaultLogo" fitHeight="80.0" pickOnBounds="true" preserveRatio="true" />
								<ImageView fx:id="mediaVaultTitle" fitHeight="50.0" pickOnBounds="true" preserveRatio="true" />
							</children>
						</HBox>

						<Region HBox.hgrow="ALWAYS" />

						<Label fx:id="mediaLabel" styleClass="active-pill" text="SHOWS" textFill="WHITE" />

						<Region HBox.hgrow="ALWAYS" />

						<HBox alignment="CENTER_RIGHT" spacing="20.0">
							<children>
								<ImageView fx:id="profileAvatar" fitHeight="55.0" pickOnBounds="true" preserveRatio="true" />
								<Label fx:id="userName" maxWidth="210.0" styleClass="profile-text" text="chisaepicmoment" />
								<ImageView fx:id="settingsIcon" fitHeight="48.0" pickOnBounds="true" preserveRatio="true" />
							</children>
						</HBox>
					</children>
				</HBox>
			</top>

			<center>
				<StackPane fx:id="contentCard" styleClass="media-details-card">
					<children>
						<Pane fx:id="dotGridPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mouseTransparent="true" />

						<VBox spacing="12.0">
							<children>
								<StackPane alignment="CENTER_LEFT" minHeight="145.0" prefHeight="145.0">
									<children>
										<Label fx:id="titleLabel" onMouseClicked="#editTitle" styleClass="media-details-title" text="Episode Title" />
										<TextField fx:id="titleField" managed="false" styleClass="media-details-title" visible="false" />
									</children>

									<VBox.margin>
										<Insets left="55.0" right="55.0" />
									</VBox.margin>
								</StackPane>

								<HBox alignment="CENTER" spacing="35.0" VBox.vgrow="ALWAYS">
									<children>
										<VBox alignment="CENTER" prefWidth="430.0" spacing="18.0">
											<children>
												<StackPane maxHeight="396.0" maxWidth="396.0" minHeight="396.0" minWidth="396.0" prefHeight="396.0" prefWidth="396.0" styleClass="media-art-border">
													<children>
														<ImageView fx:id="mediaArt" fitHeight="390.0" fitWidth="390.0" pickOnBounds="true" preserveRatio="false" />
													</children>
												</StackPane>

												<Button fx:id="editPictureButton" mnemonicParsing="false" onAction="#choosePicture" styleClass="edit-picture-button" text="Edit Picture">
													<graphic>
														<ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
															<image>
																<Image url="@/resources/application/images/icons/pencil-svgrepo-com.png" />
															</image>
														</ImageView>
													</graphic>
												</Button>
											</children>
										</VBox>

										<VBox spacing="12.0" HBox.hgrow="ALWAYS">
											<children>
												<StackPane>
													<Label fx:id="creatorLabel" maxWidth="1.7976931348623157E308" onMouseClicked="#editCreator" styleClass="info-pill" text="Writer:" />
													<TextField fx:id="creatorField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
												</StackPane>

												<StackPane>
													<Label fx:id="yearLabel" maxWidth="1.7976931348623157E308" onMouseClicked="#editYear" styleClass="info-pill" text="Year Released:" />
													<TextField fx:id="yearField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
												</StackPane>

												<StackPane>
													<Label fx:id="genreLabel" maxWidth="1.7976931348623157E308" onMouseClicked="#editGenre" styleClass="info-pill" text="Genre:" />
													<TextField fx:id="genreField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
												</StackPane>

												<HBox spacing="15.0">
													<children>
														<StackPane HBox.hgrow="ALWAYS">
															<Label fx:id="seasonNumberLabel" maxWidth="1.7976931348623157E308" styleClass="info-pill" text="Season Number:" />
															<TextField fx:id="seasonNumberField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
														</StackPane>

														<StackPane HBox.hgrow="ALWAYS">
															<Label fx:id="episodeNumberLabel" maxWidth="1.7976931348623157E308" styleClass="info-pill" text="Episode Number:" />
															<TextField fx:id="episodeNumberField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
														</StackPane>
													</children>
												</HBox>

												<HBox spacing="15.0">
													<children>
														<StackPane HBox.hgrow="ALWAYS">
															<Label fx:id="statusLabel" maxWidth="1.7976931348623157E308" onMouseClicked="#editStatus" styleClass="info-pill" text="Status:" />
															<ComboBox fx:id="statusField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
														</StackPane>

														<StackPane prefWidth="330.0">
															<children>
																<Label fx:id="ratingLabel" maxWidth="1.7976931348623157E308" onMouseClicked="#editRating" styleClass="info-pill" text="Rating:" />
																<TextField fx:id="ratingField" managed="false" maxWidth="1.7976931348623157E308" styleClass="media-edit-field" visible="false" />
															</children>
														</StackPane>
													</children>
												</HBox>

												<StackPane minHeight="205.0" prefHeight="205.0" VBox.vgrow="ALWAYS">
													<children>
														<Label fx:id="reviewLabel" alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onMouseClicked="#editReview" styleClass="info-pill, review-pill" text="Review:" />
														<TextArea fx:id="reviewField" managed="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" wrapText="true" styleClass="media-edit-field, review-text-area" visible="false" />
													</children>
												</StackPane>
											</children>
										</VBox>
									</children>

									<VBox.margin>
										<Insets left="55.0" right="55.0" />
									</VBox.margin>
								</HBox>

								<Label fx:id="errorLabel" maxHeight="22.0" maxWidth="1.7976931348623157E308" minHeight="22.0" prefHeight="22.0" styleClass="error-label" visible="false" />

								<HBox fx:id="extendableNavigationPane" alignment="CENTER" minHeight="150.0" prefHeight="150.0" spacing="25.0">
									<children>
										<Button fx:id="editButton" mnemonicParsing="false" styleClass="navigation-button" />
										<Button fx:id="backButton" mnemonicParsing="false" styleClass="navigation-button" />
										<Button fx:id="homeButton" mnemonicParsing="false" styleClass="navigation-button" />
										<Button fx:id="deleteButton" mnemonicParsing="false" styleClass="navigation-button" />
									</children>
								</HBox>
							</children>
						</VBox>
					</children>

					<BorderPane.margin>
						<Insets bottom="15.0" left="30.0" right="30.0" top="10.0" />
					</BorderPane.margin>
				</StackPane>
			</center>
		</BorderPane>
	</children>
</StackPane>