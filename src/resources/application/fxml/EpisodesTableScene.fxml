<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootStackPane" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.EpisodesTableController">
	<children>
		<Canvas fx:id="backgroundCanvas" mouseTransparent="true" />

		<BorderPane fx:id="rootPane">
			<top>
				<HBox maxHeight="130.0" minHeight="130.0" prefHeight="130.0" styleClass="nav-bar" BorderPane.alignment="CENTER">
					<children>
						<HBox alignment="CENTER_LEFT" spacing="10.0">
							<children>
								<ImageView fx:id="mediaVaultLogo" fitHeight="105.0" pickOnBounds="true" preserveRatio="true" />
								<ImageView fx:id="mediaVaultTitle" fitHeight="65.0" pickOnBounds="true" preserveRatio="true" />
							</children>
						</HBox>

						<Region HBox.hgrow="ALWAYS" />

						<Label fx:id="mediaLabel" alignment="CENTER" styleClass="font-open-sauce, active-pill" text="SHOWS" textFill="WHITE" />

						<Region HBox.hgrow="ALWAYS" />

						<HBox alignment="CENTER_RIGHT" spacing="25.0">
							<children>
								<ImageView fx:id="profileAvatar" fitHeight="65.0" pickOnBounds="true" preserveRatio="true" />
								<Label fx:id="userName" maxWidth="220.0" styleClass="font-public-sans, profile-text" text="chisaepicmoment" />
								<ImageView fx:id="settingsIcon" fitHeight="55.0" pickOnBounds="true" preserveRatio="true" />
							</children>
						</HBox>
					</children>
				</HBox>
			</top>

			<center>
				<VBox spacing="10.0" styleClass="content-card" BorderPane.alignment="CENTER">
					<children>
						<HBox alignment="CENTER_LEFT" maxHeight="120.0" minHeight="120.0" prefHeight="120.0" VBox.vgrow="NEVER">
							<children>
								<ImageView fx:id="mediaLogo" fitHeight="108.0" fitWidth="108.0" pickOnBounds="true" preserveRatio="false" />

								<Region prefWidth="20.0" />

								<Text fx:id="pageLabel" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="section-header-title" text="Episodes" />
							</children>
						</HBox>

						<StackPane VBox.vgrow="NEVER">
							<children>
								<TableView fx:id="mediaTable" maxHeight="660.0" minHeight="660.0" prefHeight="660.0" prefWidth="1360.0">
									<columns>
										<TableColumn fx:id="numberColumn" maxWidth="55.0" minWidth="55.0" prefWidth="55.0" resizable="false" sortable="false" text="#" />
										<TableColumn fx:id="titleColumn" prefWidth="220.0" resizable="false" sortable="false" text="Title" />
										<TableColumn fx:id="creatorColumn" prefWidth="180.0" resizable="false" sortable="false" text="Creator" />
										<TableColumn fx:id="yearColumn" prefWidth="90.0" resizable="false" sortable="false" text="Year" />
										<TableColumn fx:id="statusColumn" prefWidth="145.0" resizable="false" sortable="false" text="Status" />
										<TableColumn fx:id="ratingColumn" prefWidth="100.0" resizable="false" sortable="false" text="Rating" />
										<TableColumn fx:id="reviewColumn" prefWidth="145.0" resizable="false" sortable="false" text="Reviewed" />
										<TableColumn fx:id="infoColumn" prefWidth="425.0" resizable="false" sortable="false" text="Info" />
									</columns>
								</TableView>

								<Label fx:id="loadingLabel" alignment="CENTER" managed="false" styleClass="font-public-sans, loading-label" text="Loading episodes..." visible="false" StackPane.alignment="CENTER" />
							</children>
						</StackPane>

						<HBox fx:id="extendableNavigationPane" alignment="CENTER" maxHeight="120.0" minHeight="120.0" prefHeight="120.0" spacing="25.0" VBox.vgrow="NEVER">
							<children>
								<Button fx:id="backButton" mnemonicParsing="false" styleClass="navigation-button" />
								<Button fx:id="homeButton" mnemonicParsing="false" styleClass="navigation-button" />
								<Button fx:id="addEpisodeButton" mnemonicParsing="false" styleClass="navigation-button" />
								<Button fx:id="deleteLastEpisodeButton" mnemonicParsing="false" styleClass="navigation-button" />
								<Button fx:id="changeSeasonPictureButton" mnemonicParsing="false" styleClass="navigation-button" />
							</children>
						</HBox>
					</children>

					<BorderPane.margin>
						<Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
					</BorderPane.margin>
				</VBox>
			</center>
		</BorderPane>
	</children>
</StackPane>